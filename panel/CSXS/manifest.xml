<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.chopshopMCP.panel" ExtensionBundleVersion="1.2.1" ExtensionBundleName="chopshopMCP" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.chopshopMCP.panel.main" Version="1.2.1" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <!-- premiere 2022 and up, built and tested against 25.x -->
      <Host Name="PPRO" Version="[22.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.chopshopMCP.panel.main">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <!-- node is needed to spawn the python sidecar and host the mcp bridge -->
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>chopshopMCP</Menu>
          <Geometry>
            <Size>
              <Height>620</Height>
              <Width>340</Width>
            </Size>
            <MinSize>
              <Height>300</Height>
              <Width>260</Width>
            </MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
